<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral core: buffers, WAV, models, settings, logging.
       Deliberately has no Windows dependencies so it can be unit-tested anywhere. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Echodeck.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Echodeck.Core.Tests" />
  </ItemGroup>

</Project>
