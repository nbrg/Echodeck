<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phone / tablet remote: a small LAN web server (Kestrel) serving a touch soundboard page.
       Independent of the audio engine; the app plugs in an IRemoteBackend. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Echodeck.Remote</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Echodeck.Core.Tests" />
  </ItemGroup>

</Project>
