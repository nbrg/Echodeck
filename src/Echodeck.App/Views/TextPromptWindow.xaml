<Window x:Class="Echodeck.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/echodeck.ico"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="InputBox" Padding="4,3" FontSize="14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="80" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
