<?xml version="1.0" encoding="utf-8"?>
<!--
  Produces ONE self-contained Echodeck.exe for 64-bit Windows: the .NET runtime is bundled, so
  users do not need to install .NET. Used by the release workflow and by:
    dotnet publish src/Echodeck.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bundle the native WPF/runtime DLLs into the exe too (extracted to a temp cache on first run). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
