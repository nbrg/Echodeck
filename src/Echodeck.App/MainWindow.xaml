<Window x:Class="Echodeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Echodeck.App.ViewModels"
        Title="Echodeck — Discord instant replay"
        Width="900" Height="600" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Open logs" Command="{Binding OpenLogsFolderCommand}" />
                    <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: capture status + settings -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Discord capture" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Status" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CaptureStateText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Discord" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscordText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="Source" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SourceText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="3" Text="Buffer" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BufferText}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding CaptureSummary}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#444" />
                    <Border Background="#FFF4E5" BorderBrush="#F0B35B" BorderThickness="1" Padding="8" Margin="0,6,0,0"
                            Visibility="{Binding CaptureMayIncludeOtherApps, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Fallback capture: game, music and browser audio on the same device may be recorded. Per-process capture needs Windows 10 2004+ / Windows 11." />
                    </Border>

                    <TextBlock Text="Discord incoming" Style="{StaticResource Label}" Margin="0,10,0,2" />
                    <ProgressBar Height="14" Minimum="0" Maximum="1" Value="{Binding IncomingLevel, Mode=OneWay}" Foreground="#3BA55C" />

                    <TextBlock Text="Settings" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Capture method" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding CaptureModes}" SelectedItem="{Binding SelectedCaptureMode}" />
                    <TextBlock Text="Loopback device (selected-device mode)" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedLoopbackDevice}"
                              IsEnabled="{Binding IsDeviceSelectionEnabled}" />
                    <TextBlock Text="Replay buffer length" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding BufferDurations}" SelectedItem="{Binding SelectedBufferDuration}" />
                    <TextBlock Text="Local headphones (previews)" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedPreviewDevice}" />
                    <Button Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding VirtualCableText}" TextWrapping="Wrap" Foreground="#666" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- Right: replay + clips -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Instant replay" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SaveLastCommand}" FontSize="15" Padding="16,8">
                            <TextBlock>
                                <Run Text="Save last" />
                                <Run Text="{Binding SelectedQuickSave.Value, Mode=OneWay}" />
                                <Run Text="seconds" />
                            </TextBlock>
                        </Button>
                        <ComboBox ItemsSource="{Binding QuickSaveDurations}" SelectedItem="{Binding SelectedQuickSave}"
                                  Width="70" VerticalAlignment="Center" />
                    </StackPanel>

                    <DockPanel Margin="0,16,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Stop preview" Command="{Binding StopPreviewCommand}"
                                    Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Open clips folder" Command="{Binding OpenClipsFolderCommand}" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="Saved clips" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>

                <ListView ItemsSource="{Binding SavedClips}" SelectedItem="{Binding SelectedClip}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="▶ Preview" Padding="6,1" Margin="0"
                                                Command="{Binding DataContext.PreviewClipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Length" Width="70" DisplayMemberBinding="{Binding Duration, StringFormat={}{0:m\\:ss\\.f}}" />
                            <GridViewColumn Header="Created" Width="130" DisplayMemberBinding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
